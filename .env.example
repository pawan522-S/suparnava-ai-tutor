# =============================================
# WhatsApp AI English Tutor - Environment Config
# =============================================
# Copy this file to .env and fill in your values

# ─────────────────────────────────────────────
# PROVIDER SETTINGS
# ─────────────────────────────────────────────
# STT (Speech-to-Text): 'groq' = FREE | 'openai' = paid
STT_PROVIDER=groq

# AI Brain: 'groq' = FREE (LLaMA 3.3) | 'openai' = paid (GPT-4o-mini)
AI_PROVIDER=groq

# TTS (Text-to-Speech): 'google' = FREE | 'openai' = paid (better voice)
TTS_PROVIDER=google

# ─────────────────────────────────────────────
# GROQ API KEY (FREE — used for STT + AI brain)
# Sign up free at https://console.groq.com → API Keys
# No credit card needed!
# ─────────────────────────────────────────────
GROQ_API_KEY=gsk_your-groq-api-key-here

# ─────────────────────────────────────────────
# OPENAI API KEY (only needed if using openai providers above)
# Sign up at https://platform.openai.com → needs ~$5 credit
# ─────────────────────────────────────────────
OPENAI_API_KEY=sk-your-openai-api-key-here

# ─────────────────────────────────────────────
# WHATSAPP CLOUD API
# Get from https://developers.facebook.com → Your App → WhatsApp
# ─────────────────────────────────────────────
WHATSAPP_ACCESS_TOKEN=your-whatsapp-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-number-id
WHATSAPP_VERIFY_TOKEN=mysecrettoken123

# ─────────────────────────────────────────────
# SERVER
# ─────────────────────────────────────────────
PORT=3000
